{
  "name": "drive-luxury-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Drive Luxury mobile API integration layer for Client, Chauffeur and Rental Agent apps (JavaScript).",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "npm run syntax:check",
    "start": "nodemon src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "seed:test-users": "node src/scripts/seed-test-users.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky || true",
    "verify:schema": "node src/scripts/verify-legacy-schema.js",
    "format:check": "prettier --check .",
    "syntax:check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.891.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.5",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
