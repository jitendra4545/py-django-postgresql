{
  "name": "drive-luxury-backend-r1",
  "version": "2.6.2",
  "private": true,
  "description": "Drive Luxury API with fixed-schema legacy data adapters",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/client-db-upgrade.mjs --apply",
    "audit:setup": "node src/scripts/setup-api-audit.js",
    "audit:prune": "node src/scripts/prune-api-audit.js",
    "audit:selftest": "node --test scripts/selftest-api-audit.mjs",
    "verify:schema": "node scripts/verify-existing-schema.mjs",
    "syntax:check": "node scripts/check-syntax.js && node scripts/check-openapi.js && node scripts/check-client-api-contract.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run syntax:check && npm run lint && npm test",
    "stripe:check": "node scripts/check-stripe-connection.js",
    "test:stripe-network": "node scripts/test-stripe-network.js",
    "notifications:selftest": "node --experimental-test-module-mocks scripts/selftest-expo-notifications.mjs",
    "telnyx:check": "node scripts/check-telnyx-integration.js",
    "pricing:selftest": "node scripts/selftest-pricing-parity.mjs",
    "test-ui": "node scripts/serve-api-test-ui.mjs",
    "start:checked": "npm run db:client:verify && npm start",
    "payment-options:selftest": "node --test scripts/selftest-payment-options.mjs && node --experimental-test-module-mocks --test scripts/selftest-payment-http.mjs",
    "db:client:verify": "node scripts/verify-existing-schema.mjs",
    "test:client-db": "node scripts/test-exact-schema-adapter.mjs",
    "api:contract-check": "node scripts/check-client-api-contract.mjs",
    "availability:diagnose": "node scripts/diagnose-website-availability.mjs",
    "test:legacy-adapters": "node scripts/test-exact-schema-adapter.mjs",
    "test:mobile-enhancements": "node scripts/test-mobile-enhancements.mjs",
    "test:shared-policy": "node scripts/test-shared-policy.mjs",
    "agent:test-sql": "node scripts/generate-test-agent-sql.mjs",
    "test:rental-catalog": "node scripts/test-rental-catalog.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.891.0",
    "@aws-sdk/s3-request-presigner": "^3.891.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.2",
    "expo-server-sdk": "^7.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fs": "^0.0.1-security",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.5",
    "nodemailer": "^10.1.1",
    "socket.io": "^4.8.1",
    "stripe": "^23.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "winston": "^3.17.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
