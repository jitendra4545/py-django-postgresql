                                "amount"
                              ],
                              "properties": {
                                "key": {
                                  "type": "string"
                                },
                                "label": {
                                  "type": "string"
                                },
                                "amount": {
                                  "type": "number"
                                }
                              }
                            }
                          },
                          "options": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "tax": {
                            "type": "object",
                            "properties": {
                              "ratePercent": {
                                "type": "number",
                                "nullable": true
                              },
                              "taxableBase": {
                                "type": "number",
                                "nullable": true
                              },
                              "amount": {
                                "type": "number"
                              },
                              "basis": {
                                "type": "string",
                                "enum": [
                                  "BASE_FEE_ONLY",
                                  "RECORDED"
                                ]
                              },
                              "note": {
                                "type": "string",
                                "nullable": true
                              }
                            }
                          },
                          "totals": {
                            "type": "object",
                            "properties": {
                              "baseFee": {
                                "type": "number"
                              },
                              "options": {
                                "type": "number"
                              },
                              "oneWayCharge": {
                                "type": "number"
                              },
                              "chauffeurExtraCost": {
                                "type": "number"
                              },
                              "insuranceCost": {
                                "type": "number"
                              },
                              "discount": {
                                "type": "number"
                              },
                              "netCost": {
                                "type": "number"
                              },
                              "tax": {
                                "type": "number"
                              },
                              "roundingAdjustment": {
                                "type": "number"
                              },
                              "priceAdjustment": {
                                "type": "number"
                              },
                              "total": {
                                "type": "number"
                              }
                            }
                          }
                        }
                      }
                    },
                    "summary": {
                      "type": "object",
                      "required": [
                        "total",
                        "paid",
                        "amountDue"
                      ],
                      "properties": {
                        "total": {
                          "type": "number"
                        },
                        "paid": {
                          "type": "number"
                        },
                        "amountDue": {
                          "type": "number"
                        }
                      }
                    },
                    "payment": {
                      "type": "object",
                      "properties": {
                        "paymentId": {
                          "type": "integer",
                          "nullable": true
                        },
                        "paymentState": {
                          "type": "string",
                          "nullable": true
                        },
                        "canPay": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "409": {
            "description": "Active booking, assignment, payment or quote conflict"
          },
          "422": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    },
