    "/operations/bookings/{reservationId}/customer-charges": {
      "post": {
        "summary": "Admin explicitly bills an additional native reservation fee, optionally linked to an approved driver expense",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "reservationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "amount"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 191
                  },
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "expenseId": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created zero-tax fee; balance is exposed by existing booking and payment-breakdown reads"
          },
          "200": {
            "description": "Same durable idempotency reference reused"
          },
          "403": {
            "description": "Admin role required"
          },
          "409": {
            "description": "Cancelled booking, rejected/unreviewed expense, previously billed expense, or key conflict"
          }
        }
      }
    }
  }
}
