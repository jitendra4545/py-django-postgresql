    "/catalog/vehicle-classes/{vehicleClassId}/booking-options": {
      "get": {
        "summary": "Class-mapped rental extras and separate insurance choices",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "vehicleClassId",
                    "serviceCode",
                    "options",
                    "insuranceChoices",
                    "defaultInsuranceType"
                  ],
                  "properties": {
                    "vehicleClassId": {
                      "type": "integer"
                    },
                    "serviceCode": {
                      "type": "string"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "insuranceChoices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "unitAmount": {
                            "type": "number"
                          },
                          "billingUnit": {
                            "type": "string"
                          },
                          "included": {
                            "type": "boolean"
                          },
                          "description": {
                            "type": "string",
                            "nullable": true
                          }
                        }
                      }
                    },
                    "defaultInsuranceType": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "409": {
            "description": "Active booking, assignment, payment or quote conflict"
          },
          "422": {
            "description": "Invalid request"
          }
        },
        "parameters": [
          {
            "name": "vehicleClassId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "serviceCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "CHAUFFEUR",
                "CAR_RENTAL",
                "TRANSFER"
              ]
            }
          }
        ]
      }
    },
