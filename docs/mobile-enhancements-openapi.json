{
  "paths": {
    "/auth/account": {
      "delete": {
        "summary": "Delete own client, chauffeur or agent account (soft deletion with reauthentication)",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "userId",
                    "profileId",
                    "role",
                    "deleted"
                  ],
                  "properties": {
                    "userId": {
                      "type": "integer"
                    },
                    "profileId": {
                      "type": "integer"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "CLIENT",
                        "CHAUFFEUR",
                        "AGENCY_AGENT"
                      ]
                    },
                    "deleted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "409": {
            "description": "Active booking, assignment, payment or quote conflict"
          },
          "422": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "confirm"
                ],
                "properties": {
                  "confirm": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "idToken": {
                    "type": "string",
                    "minLength": 20
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "password"
                    ],
                    "not": {
                      "required": [
                        "idToken"
                      ]
                    }
                  },
                  {
                    "required": [
                      "idToken"
                    ],
                    "not": {
                      "required": [
                        "password"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
