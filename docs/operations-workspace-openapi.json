{
  "openapi": "3.0.3",
  "info": {
    "title": "Drive Luxury staff workspace addendum",
    "version": "2026-11-10"
  },
  "paths": {
    "/operations/workspace": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Read staff review queues, directories and native booking allocations",
        "description": "Admin and Staff only. view=summary returns counts; queue uses kind changes/cancellations/expenses/incidents; directory uses customers/agents/agencies/chauffeurs; booking requires reservationId and returns current native extras, costs, payments and task windows. No business writes.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "summary",
                "queue",
                "directory",
                "booking"
              ]
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "changes",
                "cancellations",
                "expenses",
                "incidents",
                "customers",
                "agents",
                "agencies",
                "chauffeurs"
              ]
            }
          },
          {
            "name": "reservationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requested staff workspace view"
          },
          "403": {
            "description": "Admin or Staff role required"
          },
          "422": {
            "description": "Invalid view or required parameters"
          }
        }
      }
    }
  }
}
