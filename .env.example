NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=drive_luxury
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_CA_PATH=
# Alternative for DigitalOcean App Platform: base64-encoded CA certificate.
DB_SSL_CA_BASE64=

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated OAuth client IDs accepted from Android, iOS and Web builds.
GOOGLE_CLIENT_IDS=replace-with-google-client-id.apps.googleusercontent.com
# Server-side Places API (New). Do not put a real key in this file or the ZIP.
GOOGLE_PLACES_API_KEY=
# Routes API must also be enabled for verified, distance-dependent quotations.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_ENABLED=false
# Testing only: explicitly accept frontend-supplied kilometres on local/staging.
ALLOW_UNVERIFIED_DISTANCE=false

# Use "disabled" for local development or "smtp" for staging/production.
# Infomaniak SMTP uses MAIL_ENCRYPTION=tls with port 587.
EMAIL_PROVIDER=disabled
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_ADDRESS=noreply@drive-luxury.com
MAIL_FROM_NAME=Drive Luxury
MAIL_REPLY_TO=support@drive-luxury.com
# Web or mobile deep link opened from the emails. The API adds token parameters automatically.
PASSWORD_RESET_URL=https://api.example.com/reset-password
INVITATION_ACCEPT_URL=driveluxury://invitation

# Use "stripe" outside local mock development. Never commit real keys.
PAYMENT_PROVIDER=mock
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Production-safe default. Add a provider adapter before enabling masked calls.
MASKED_CALL_PROVIDER=disabled
MASKED_CALL_TTL_SECONDS=600
SUPPORT_PHONE=

GPS_MIN_INTERVAL_SECONDS=5
GPS_STALE_AFTER_SECONDS=45

UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
DO_SPACES_KEY=replace-with-spaces-access-key
DO_SPACES_SECRET=replace-with-spaces-secret
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=replace-with-bucket-name
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_CDN_ENDPOINT=https://replace-with-bucket-name.fra1.cdn.digitaloceanspaces.com
DO_SPACES_PUBLIC_ROOT=images
DO_SPACES_PRIVATE_ROOT=private
MEDIA_CDN_ENABLED=false

# Existing website invoice records (Ops creates invoices).
INVOICE_ADAPTER=legacy
LEGACY_INVOICE_TABLE=reservation_invoices
LEGACY_INVOICE_RESERVATION_COLUMN=reservation_id
LEGACY_PAID_PAYMENT_STATUS=20

REDIS_URL=
# Optional for Expo projects with push security enabled.
EXPO_ACCESS_TOKEN=
LOG_LEVEL=info
