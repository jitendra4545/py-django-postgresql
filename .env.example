NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=drive_luxury
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_CA_PATH=

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated OAuth client IDs accepted from Android, iOS and Web builds.
GOOGLE_CLIENT_IDS=replace-with-google-client-id.apps.googleusercontent.com

# Use "disabled" for local development or "smtp" for staging/production.
# Infomaniak SMTP uses MAIL_ENCRYPTION=tls with port 587.
EMAIL_PROVIDER=disabled
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_ADDRESS=noreply@drive-luxury.com
MAIL_FROM_NAME=Drive Luxury
MAIL_REPLY_TO=support@drive-luxury.com
# Web or mobile deep link opened from the reset email. The API adds ?token= automatically.
PASSWORD_RESET_URL=https://app.drive-luxury.com/reset-password

# Use "stripe" outside local mock development. Never commit real keys.
PAYMENT_PROVIDER=mock
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
MASKED_CALL_PROVIDER=mock

UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

REDIS_URL=
# Optional for Expo projects with push security enabled.
EXPO_ACCESS_TOKEN=
LOG_LEVEL=info
