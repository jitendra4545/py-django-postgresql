NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=drive_luxury
DB_CONNECTION_LIMIT=20

REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=change-this-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

DEFAULT_COUNTRY_ID=1
DEFAULT_CURRENCY=EUR
LEGACY_NEW_USER_STATUS=0
ENFORCE_LEGACY_USER_STATUS=false
AUTO_CONFIRM_BOOKINGS=false
ALLOW_BACKOFFICE_TEST_API=true

# Legacy reservation service_type mapping inferred from the supplied SQL schema:
# 1=car with driver/limousine, 2=car rental, 3=transfer.
SERVICE_TYPE_CHAUFFEUR=1
SERVICE_TYPE_CAR_RENTAL=2
SERVICE_TYPE_TRANSFER=3

PAYMENT_PROVIDER=mock
MASKED_CALL_PROVIDER=mock

STORAGE_DRIVER=local
UPLOAD_DIR=uploads
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

GOOGLE_CLIENT_ID=

# Optional FCM push notifications. If omitted, notifications are persisted + Socket.IO emitted only.
FIREBASE_SERVICE_ACCOUNT_JSON=

TEST_ADMIN_EMAIL=admin.mobile@drive-luxury.local
TEST_ADMIN_PASSWORD=Admin123!
TEST_DRIVER_EMAIL=driver.mobile@drive-luxury.local
TEST_DRIVER_PASSWORD=Driver123!
TEST_AGENT_EMAIL=agent.mobile@drive-luxury.local
TEST_AGENT_PASSWORD=Agent123!
