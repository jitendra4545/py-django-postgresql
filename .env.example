NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=drive_luxury_local
DB_SSL=false
DB_CONNECTION_LIMIT=10
JWT_ACCESS_SECRET=replace-with-your-own-long-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-your-own-long-refresh-secret-at-least-32-characters
PAYMENT_PROVIDER=mock
GOOGLE_CLIENT_IDS=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_ENABLED=false
ALLOW_UNVERIFIED_DISTANCE=false
EMAIL_PROVIDER=disabled
PASSWORD_RESET_URL=http://localhost:3000/reset-password
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
EXPO_PUSH_WORKER_ENABLED=false
API_AUDIT_LOG_ENABLED=true
INVOICE_ADAPTER=legacy
MASKED_CALL_PROVIDER=disabled
# Match the client Laravel notification morph class if it differs from this default.
LEGACY_USER_MODEL=App\User
DRIVER_BOOKING_TASK_MINUTES=120
DRIVER_BOOKING_BUFFER_MINUTES=60
DRIVER_BOOKING_MAX_JOB_MINUTES=1440
