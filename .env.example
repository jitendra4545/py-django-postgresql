NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=drive_luxury
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_CA_PATH=

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Use "stripe" outside local mock development. Never commit real keys.
PAYMENT_PROVIDER=stripe
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
MASKED_CALL_PROVIDER=mock

UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

REDIS_URL=
# Optional for Expo projects with push security enabled.
EXPO_ACCESS_TOKEN=
LOG_LEVEL=info
