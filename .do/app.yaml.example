name: drive-luxury-api
region: fra
services:
  - name: api
    github:
      repo: YOUR_GITHUB_ORG/YOUR_REPOSITORY
      branch: main
      deploy_on_push: false
    source_dir: /
    dockerfile_path: Dockerfile
    http_port: 3000
    instance_count: 1
    instance_size_slug: basic-xxs
    health_check:
      http_path: /health
      initial_delay_seconds: 20
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 3
    routes:
      - path: /
    envs:
      - key: NODE_ENV
        scope: RUN_TIME
        value: production
      - key: PORT
        scope: RUN_TIME
        value: "3000"
      - key: API_PREFIX
        scope: RUN_TIME
        value: /api/v1
      - key: APP_URL
        scope: RUN_TIME
        value: https://api.example.com
      - key: CORS_ORIGINS
        scope: RUN_TIME
        value: https://app.example.com
      - key: DB_HOST
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: DB_PORT
        scope: RUN_TIME
        value: "25060"
      - key: DB_NAME
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: DB_USER
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: DB_PASSWORD
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: DB_SSL
        scope: RUN_TIME
        value: "true"
      - key: DB_SSL_CA_BASE64
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: JWT_ACCESS_SECRET
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: JWT_REFRESH_SECRET
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: GOOGLE_CLIENT_IDS
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: GOOGLE_PLACES_API_KEY
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: GOOGLE_ROUTES_API_KEY
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: GOOGLE_ROUTES_ENABLED
        scope: RUN_TIME
        value: "true"
      - key: EMAIL_PROVIDER
        scope: RUN_TIME
        value: smtp
      - key: MAIL_HOST
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: MAIL_PORT
        scope: RUN_TIME
        value: "587"
      - key: MAIL_ENCRYPTION
        scope: RUN_TIME
        value: tls
      - key: MAIL_USERNAME
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: MAIL_PASSWORD
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: MAIL_FROM_ADDRESS
        scope: RUN_TIME
        value: noreply@example.com
      - key: PASSWORD_RESET_URL
        scope: RUN_TIME
        value: https://api.example.com/reset-password
      - key: INVITATION_ACCEPT_URL
        scope: RUN_TIME
        value: driveluxury://invitation
      - key: PAYMENT_PROVIDER
        scope: RUN_TIME
        value: stripe
      - key: STRIPE_SECRET_KEY
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: STRIPE_WEBHOOK_SECRET
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: UPLOAD_DRIVER
        scope: RUN_TIME
        value: spaces
      - key: DO_SPACES_KEY
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: DO_SPACES_SECRET
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: DO_SPACES_REGION
        scope: RUN_TIME
        value: fra1
      - key: DO_SPACES_BUCKET
        scope: RUN_TIME
        value: CHANGE_ME
      - key: DO_SPACES_ENDPOINT
        scope: RUN_TIME
        value: https://fra1.digitaloceanspaces.com
      - key: DO_SPACES_CDN_ENDPOINT
        scope: RUN_TIME
        value: https://CHANGE_ME.fra1.cdn.digitaloceanspaces.com
      - key: DO_SPACES_PUBLIC_ROOT
        scope: RUN_TIME
        value: images
      - key: DO_SPACES_PRIVATE_ROOT
        scope: RUN_TIME
        value: private
      - key: MEDIA_CDN_ENABLED
        scope: RUN_TIME
        value: "true"
      - key: MASKED_CALL_PROVIDER
        scope: RUN_TIME
        value: disabled
      - key: INVOICE_ADAPTER
        scope: RUN_TIME
        value: legacy
      - key: LEGACY_INVOICE_TABLE
        scope: RUN_TIME
        value: reservation_invoices
      - key: LEGACY_PAID_PAYMENT_STATUS
        scope: RUN_TIME
        value: "20"
      - key: EXPO_ACCESS_TOKEN
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
